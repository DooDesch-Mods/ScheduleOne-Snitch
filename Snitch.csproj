<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared release hardening: strip Release debug info + assembly identity, cuts AV false positives (see Workspace/build/Hardening.props). -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/Hardening.props')" />

  <!--
    Snitch - MelonLoader IL2CPP performance profiler for Schedule I.
    A general-purpose, extensible profiler: it measures the COST and STATE of NPCs, trash, quests and any
    modder-registered system, exposes a public no-op-when-absent API (Snitch.Api), an in-game HUD, and a
    local HTTP + WebSocket server that streams everything to the SnitchWeb dashboard (hosted + offline).
    Honest by design: frame-time is the load-bearing truth; every other number self-certifies; the profiler
    reports its own overhead. Cloned from the Siesta/Litterally template (net6.0 => Backend=il2cpp, refs from
    Workspace/lib/il2cpp).
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Snitch</RootNamespace>
    <AssemblyName>Snitch</AssemblyName>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>1.6.1</Version>
    <AssemblyVersion>1.6.1.0</AssemblyVersion>
    <FileVersion>1.6.1.0</FileVersion>
    <!-- Suppress MSB3277/MSB3245 noise from il2cpp interop transitive refs -->
    <NoWarn>$(NoWarn);MSB3277;MSB3245</NoWarn>

    <!-- Workspace lib roots (mirrors Siesta ../Workspace/lib) -->
    <WorkspaceLibPath Condition="'$(WorkspaceLibPath)' == ''">$(MSBuildThisFileDirectory)../Workspace/lib</WorkspaceLibPath>
    <!-- The test copy, never the real install. A build that lands in the Steam directory replaces the DLL a player
         is running, and there is no copy of what it replaced. Pass -p:ModsDirectory=... for a real beta test,
         deliberately. -->
    <ModsDirectory Condition="'$(ModsDirectory)' == ''">$(MSBuildThisFileDirectory)..\_MPTest\Schedule I\Mods</ModsDirectory>
  </PropertyGroup>

  <!-- Backend selection derived from the active TargetFramework -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <Backend>il2cpp</Backend>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Backend>mono</Backend>
    <DefineConstants>$(DefineConstants);MONO</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <GameManagedPath>$(WorkspaceLibPath)/$(Backend)/game</GameManagedPath>
    <MelonLoaderPath>$(WorkspaceLibPath)/$(Backend)/melonloader</MelonLoaderPath>
  </PropertyGroup>

  <!-- Backend-specific GlobalUsings: keep only the active backend's file -->
  <ItemGroup>
    <Compile Remove="Compat/GlobalUsings.Il2Cpp.cs" Condition="'$(Backend)' != 'il2cpp'" />
    <Compile Remove="Compat/GlobalUsings.Mono.cs" Condition="'$(Backend)' != 'mono'" />
  </ItemGroup>

  <!-- On CI the build-libs repo is checked out into ./Workspace, so its source (the shared uGUI design-system
       under Workspace/ui, etc.) would otherwise be swept into the default compile glob. Snitch references only
       the Workspace/lib DLLs and compiles none of that source. Locally Workspace is a sibling folder, so this
       Remove is a no-op there. -->
  <ItemGroup>
    <Compile Remove="Workspace/**/*.cs" />
    <!-- The modder shim is its own assembly and lives in this repo only so modders can get it.
         Compiling it into the host too would give the mod a second copy of the client that binds to itself. -->
    <Compile Remove="Snitch.Api/**/*.cs" />
  </ItemGroup>

  <!-- hash's shim: one file, no references, no hard dependency. It puts this mod's own console words into the
       game's command list so anything that lists commands can see them. Taken from the hash checkout beside this
       one when there is one, and from the workspace copy otherwise - CI checks out this repo alone.

       It has to come after the Compile Remove above: on CI the workspace repo is checked out INTO this one,
       so Workspace/**/*.cs matches the shim's own path and a Remove after the Include wins. -->
  <PropertyGroup>
    <HashShimPath Condition="Exists('$(MSBuildThisFileDirectory)../Hash/Hash.Api/HashCommands.cs')">$(MSBuildThisFileDirectory)../Hash/Hash.Api/HashCommands.cs</HashShimPath>
    <HashShimPath Condition="'$(HashShimPath)' == '' And Exists('$(WorkspaceLibPath)/hash-api/HashCommands.cs')">$(WorkspaceLibPath)/hash-api/HashCommands.cs</HashShimPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(HashShimPath)' != ''">
    <Compile Include="$(HashShimPath)" Link="Hash.Api/HashCommands.cs" />
  </ItemGroup>


  <!-- The Hotline framework's modder shim is VENDORED as a single dropped-in file at Compat/HotlineApi.cs (the
       droppable single-file form of Hotline.Api). Snitch forwards its per-mod panels to the Hotline in-game overlay
       through it (a no-op when Hotline is not installed). It is part of Snitch's own source, so it compiles on CI
       with no sibling/Workspace path. Re-vendor from ../Hotline.Api/Hotline.cs only if the Hotline ABI changes. -->

  <!-- Mod loader references (both backends) -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderPath)/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderPath)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- IL2CPP-only references -->
  <ItemGroup Condition="'$(Backend)' == 'il2cpp'">
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderPath)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameManagedPath)/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(GameManagedPath)/Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppScheduleOne.Core">
      <HintPath>$(GameManagedPath)/Il2CppScheduleOne.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppFishNet.Runtime">
      <HintPath>$(GameManagedPath)/Il2CppFishNet.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="S1API.Il2Cpp.MelonLoader">
      <HintPath>$(WorkspaceLibPath)/il2cpp/s1api/S1API.Il2Cpp.MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ProfilerModule">
      <HintPath>$(GameManagedPath)/UnityEngine.ProfilerModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManagedPath)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(GameManagedPath)/UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedPath)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Mod Manager &amp; Phone App is an OPTIONAL runtime dependency (declared via MelonOptionalDependencies in
         Core.cs). Snitch calls none of its API, so no compile-time reference is needed; its settings UI
         auto-detects Snitch via the category id prefix. -->
  </ItemGroup>

  <!--
    NOTE: there is intentionally NO reference to Snitch.Api here. The modder shim (Snitch.Api) is fully
    decoupled from the host: it locates the host's Snitch.Bridge.SnitchBridge delegate table by reflection
    and all data crosses as primitives, so the two assemblies share no types. The host publishes the bridge;
    modders consume the shim. Built-in providers dogfood the internal registries directly.
  -->

  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Condition="Exists('$(ModsDirectory)')"
          Command="cmd /c if exist &quot;$(ModsDirectory)&quot; copy /Y &quot;$(TargetPath)&quot; &quot;$(ModsDirectory)&quot;"
          ContinueOnError="true" />
  </Target>

</Project>
